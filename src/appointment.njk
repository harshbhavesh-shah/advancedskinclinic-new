<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book an Appointment | Advanced Skin Clinic</title>
    <link rel="icon" type="image/png" href="/assets/images/logo.png">
    <link rel="apple-touch-icon" href="/assets/images/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet">

    <!-- Flatpickr CSS for the custom date picker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!-- Flatpickr Custom Theme -->
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/airbnb.css">

    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html, body {
            height: 100%;
            overflow-x: hidden;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
            color: #5f6b62;
            background-color: #f6f7f2;
            background-image: radial-gradient(120% 100% at 15% 0%, #eceee4 0%, #f6f7f2 55%);
            min-height: 100vh;
        }

        /* ---------- Page content ---------- */
        .form-content-area {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
        }
        .mockup-card {
            background-color: #fdfdfa;
            width: 100%;
            max-width: 650px;
            padding: 48px 55px;
            border-radius: 24px;
            border: 1px solid #dde1d6;
            box-shadow: 0 30px 60px -30px rgba(60,44,20,0.25);
        }
        .card-eyebrow {
            text-align: center;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #3f6d5c;
            margin-bottom: 10px;
        }
        h2 {
            font-family: 'Fraunces', Georgia, serif;
            font-weight: 400;
            font-size: 2.2rem;
            margin-bottom: 8px;
            text-align: center;
            color: #1e2420;
        }
        .card-subtitle {
            text-align: center;
            font-size: 0.95rem;
            color: #5f6b62;
            margin-bottom: 35px;
        }
        .form-row {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        .form-label {
            width: 140px;
            font-size: 16px;
            color: #1e2420;
            font-weight: 600;
            flex-shrink: 0;
        }
        .form-field-wrapper {
            flex-grow: 1;
            display: flex;
            gap: 15px;
            align-items: center;
            min-width: 0;
        }
        .input-box {
            width: 100%;
            background-color: #f6f7f2;
            border: 1px solid #dde1d6;
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 15px;
            font-family: inherit;
            outline: none;
            color: #1e2420;
        }
        .input-box:focus {
            border-color: #3f6d5c;
        }
        .input-box option:disabled {
            color: #b0b0b0;
            background-color: #f0f0f0;
        }
        .submit-btn-row {
            margin-top: 30px;
            display: flex;
            justify-content: center;
        }
        .btn-submit {
            padding: 14px 34px;
            font-size: 1rem;
            font-family: inherit;
            font-weight: 600;
            letter-spacing: 0.2px;
            cursor: pointer;
            border: none;
            border-radius: 999px;
            background-color: #3f6d5c;
            color: #fff;
            transition: background-color 0.3s;
        }
        .btn-submit:hover {
            background-color: #2d5145;
        }
        @media (max-width: 600px) {
            html, body {
                height: 100dvh;
                overflow: hidden;
                overscroll-behavior: none;
            }
            body {
                display: flex;
                flex-direction: column;
            }
            header {
                flex-shrink: 0;
            }
            .form-row {
                flex-direction: column;
                align-items: flex-start;
                gap: clamp(3px, 0.7vh, 6px);
                margin-bottom: 0;
            }
            .form-label {
                width: auto;
                font-size: clamp(13px, 2.1vh, 15px);
                font-weight: 600;
            }
            .form-field-wrapper {
                flex-direction: column;
                align-items: stretch;
                gap: clamp(6px, 1.1vh, 10px);
                width: 100%;
            }
            .form-field-wrapper > div {
                width: 100% !important;
            }
            .input-box {
                padding: clamp(9px, 1.6vh, 12px) 12px;
                font-size: clamp(13px, 2vh, 15px);
            }
            .submit-btn-row {
                justify-content: stretch;
                margin-top: clamp(2px, 0.5vh, 4px);
            }
            .btn-submit {
                width: 100%;
                padding: clamp(11px, 2vh, 15px) 20px;
                font-size: clamp(13px, 2vh, 15px);
            }
            .form-content-area {
                flex: 1 1 auto;
                min-height: 0;
                overflow: hidden;
                padding: 1.6vh 4vw;
                display: flex;
                align-items: stretch;
                justify-content: center;
            }
            .mockup-card {
                width: 100%;
                height: 100%;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 2.4vh 6vw;
                box-shadow: none;
            }
            .card-eyebrow {
                flex-shrink: 0;
                font-size: clamp(10px, 1.8vh, 12px);
                letter-spacing: 1.5px;
                margin-bottom: clamp(4px, 0.8vh, 8px);
            }
            h2 {
                flex-shrink: 0;
                font-size: clamp(19px, 3.6vh, 25px);
                line-height: 1.15;
                margin-bottom: clamp(3px, 0.6vh, 6px);
            }
            .card-subtitle {
                flex-shrink: 0;
                font-size: clamp(11px, 1.9vh, 13px);
                margin-bottom: clamp(10px, 2vh, 18px);
            }
            #appointmentForm {
                flex: 0 1 auto;
                min-height: 0;
                display: flex;
                flex-direction: column;
                gap: clamp(9px, 1.8vh, 16px);
            }
        }
    </style>
</head>
<body>

    {% include "partials/header.njk" %}

        <div class="form-content-area">
            <div class="mockup-card">
                <div class="card-eyebrow">Advanced Skin Clinic</div>
                <h2>Schedule Your Appointment</h2>
                <p class="card-subtitle">Start protecting your skin today.</p>
                <form id="appointmentForm">
                    <input type="hidden" id="service" value="Consultation">

                    <div class="form-row">
                        <label for="name" class="form-label">Name</label>
                        <div class="form-field-wrapper">
                            <input type="text" id="name" class="input-box" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <label for="phone" class="form-label">Number</label>
                        <div class="form-field-wrapper">
                            <input type="tel" id="phone" class="input-box" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <label class="form-label">Schedule</label>
                        <div class="form-field-wrapper">
                            <!-- Wrapped in divs to ensure perfect 50/50 sizing immune to injected DOM elements -->
                            <div style="flex: 1; min-width: 0; width: 100%;">
                                <input type="text" id="date" name="date" class="input-box" placeholder="Select Date" required>
                            </div>
                            <div style="flex: 1; min-width: 0; width: 100%;">
                                <select id="time" class="input-box" required>
                                    <option value="" disabled selected>-- Select Time --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="submit-btn-row">
                        <button type="submit" class="btn-submit">Confirm Appointment</button>
                    </div>
                </form>
            </div>
        </div>

    <script>
        var mobileToggle = document.querySelector('.mobile-toggle');
        var navLinks = document.querySelector('nav.links');
        mobileToggle?.addEventListener('click', function(){
            var isOpen = navLinks.classList.toggle('mobile-open');
            mobileToggle.classList.toggle('open', isOpen);
            mobileToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        navLinks?.querySelectorAll('a').forEach(function(a){
            a.addEventListener('click', function(){
                navLinks.classList.remove('mobile-open');
                mobileToggle.classList.remove('open');
                mobileToggle.setAttribute('aria-expanded', 'false');
            });
        });
    </script>

    <!-- Flatpickr JS library -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
        import { getFirestore, collection, addDoc, doc, setDoc, getDoc, getDocs, query, where, onSnapshot } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
        import { reassignDailyTokens, countStillWaitingAhead } from "/assets/js/token-utils.js";

        const firebaseConfig = {
            apiKey: "AIzaSyDstFH1FUnW3YQVk-XUWC5rjMWuWxo5jjA",
            authDomain: "appointment-booking-1f0d0.firebaseapp.com",
            projectId: "appointment-booking-1f0d0",
            storageBucket: "appointment-booking-1f0d0.firebasestorage.app",
            messagingSenderId: "572909099522",
            appId: "1:572909099522:web:a40cb6dc7fafe8ea7e651b"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        const serviceInput = document.getElementById('service');
        const dateInput = document.getElementById('date');
        const timeSelect = document.getElementById('time');

        // --- TIME FORMATTING HELPER ---
        function formatTo12Hour(timeStr) {
            if (!timeStr) return '';
            const parts = timeStr.split(':');
            if (parts.length < 2) return timeStr;
            
            let hours = parseInt(parts[0], 10);
            const minutes = parts[1];
            
            if (isNaN(hours)) return timeStr;
            
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            
            return `${hours}:${minutes} ${ampm}`;
        }

        // --- DAY-LEVEL AVAILABILITY (set by the doctor/reception in calendar.html) ---
        // Fallback used only if the clinic-wide "settings/hours" doc has
        // never been saved, or fails to load.
        const FALLBACK_HOURS = {
            morning_start: "10:00",
            morning_end: "13:30",
            evening_start: "16:30",
            evening_end: "19:30"
        };

        let defaultHours = { ...FALLBACK_HOURS }; // clinic-wide default, editable in calendar.html
        let availabilityMap = {}; // dateStr -> { unavailable, morning_start, morning_end, evening_start, evening_end }

        function toLocalDateStr(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        async function loadAvailability() {
            try {
                const [defaultSnap, overridesSnap] = await Promise.all([
                    getDoc(doc(db, "settings", "hours")),
                    getDocs(collection(db, "availability"))
                ]);

                if (defaultSnap.exists()) {
                    defaultHours = { ...FALLBACK_HOURS, ...defaultSnap.data() };
                }

                const map = {};
                overridesSnap.forEach(docSnap => { map[docSnap.id] = docSnap.data(); });
                availabilityMap = map;
            } catch (error) {
                console.error("Could not load availability/default hours, falling back to built-in defaults:", error);
                availabilityMap = {};
            }
        }

        // --- INITIALIZE FLATPICKR (GREYS OUT SUNDAYS + DOCTOR-CLOSED DAYS) ---
        async function initDatePicker() {
            await loadAvailability();

            flatpickr("#date", {
                minDate: "today",
                dateFormat: "Y-m-d", // Keeps standard data format matching Firebase
                altInput: true,
                altFormat: "d/m/Y", // Visual presentation
                disable: [
                    function(date) {
                        // Disable Sundays (0 = Sunday)
                        if (date.getDay() === 0) return true;
                        // Disable days the doctor has marked fully closed
                        const entry = availabilityMap[toLocalDateStr(date)];
                        return !!(entry && entry.unavailable);
                    }
                ],
                onReady: function(selectedDates, dateStr, instance) {
                    // Ensure default date is valid
                    let defaultDate = new Date();
                    while (defaultDate.getDay() === 0 || (availabilityMap[toLocalDateStr(defaultDate)] && availabilityMap[toLocalDateStr(defaultDate)].unavailable)) {
                        defaultDate.setDate(defaultDate.getDate() + 1);
                    }
                    instance.setDate(defaultDate, true);
                },
                onChange: function(selectedDates, dateStr, instance) {
                    updateAvailableTimeSlots();
                }
            });
        }

        initDatePicker();

        // --- GENERATE AND SYNC SLOT CONFLICTS ---
        function generateTimeSlots(service, dateStr) {
            const interval = 10;
            const slots = [];

            function addSlotsInRange(startTime, endTime) {
                if (!startTime || !endTime) return; // that shift is closed for this date
                const [startHour, startMin] = startTime.split(':').map(Number);
                const [endHour, endMin] = endTime.split(':').map(Number);
                const startTotalMins = startHour * 60 + startMin;
                const endTotalMins = endHour * 60 + endMin;

                for (let m = startTotalMins; m <= endTotalMins; m += interval) {
                    const hh = String(Math.floor(m / 60)).padStart(2, '0');
                    const mins = String(m % 60).padStart(2, '0');
                    slots.push(`${hh}:${mins}`);
                }
            }

            const entry = dateStr ? availabilityMap[dateStr] : null;
            const morningStart = entry && entry.morning_start !== undefined ? entry.morning_start : defaultHours.morning_start;
            const morningEnd = entry && entry.morning_end !== undefined ? entry.morning_end : defaultHours.morning_end;
            const eveningStart = entry && entry.evening_start !== undefined ? entry.evening_start : defaultHours.evening_start;
            const eveningEnd = entry && entry.evening_end !== undefined ? entry.evening_end : defaultHours.evening_end;

            // Morning shift
            addSlotsInRange(morningStart, morningEnd);

            // Add a clear text divider flag for the dropdown renderer to catch
            slots.push("DIVIDER");

            // Afternoon/Evening shift
            addSlotsInRange(eveningStart, eveningEnd);

            return slots;
        }

        let unsubscribeSlots = null;

        function updateAvailableTimeSlots() {
            if (unsubscribeSlots) unsubscribeSlots();

            const selectedService = serviceInput.value;
            // Get raw YYYY-MM-DD from Flatpickr
            const selectedDate = document.getElementById('date').value;

            if (!selectedService || !selectedDate) return;

            const timeSlots = generateTimeSlots(selectedService, selectedDate);

            const q = query(
                collection(db, "appointments"),
                where("service_type", "==", selectedService),
                where("appointment_date", "==", selectedDate)
            );

            unsubscribeSlots = onSnapshot(q, (snapshot) => {
                const bookedTimes = new Set();
                snapshot.forEach((doc) => {
                    const data = doc.data();
                    if (data.appointment_time) {
                        bookedTimes.add(data.appointment_time);
                    }
                });

                const currentSelection = timeSelect.value;
                timeSelect.innerHTML = '<option value="" disabled selected>-- Select Time --</option>';

                timeSlots.forEach(slot => {
                    // Check for our custom separator
                    if (slot === "DIVIDER") {
                        const divider = document.createElement('option');
                        divider.disabled = true;
                        divider.textContent = '────── Evening ──────';
                        timeSelect.appendChild(divider);
                        return; // exit current loop cycle
                    }

                    const option = document.createElement('option');
                    option.value = slot;
                    option.textContent = formatTo12Hour(slot); // Render to user as 12hr

                    if (bookedTimes.has(slot)) {
                        option.disabled = true;
                        option.textContent += ' (Booked)';
                    }
                    timeSelect.appendChild(option);
                });

                if (currentSelection && !bookedTimes.has(currentSelection)) {
                    timeSelect.value = currentSelection;
                }
            });
        }

        // --- HANDLE FORM SUBMISSION ---
        const submitBtn = document.querySelector('#appointmentForm .btn-submit');
        document.getElementById('appointmentForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            if (submitBtn.disabled) return; // already submitting — ignores a second click
            submitBtn.disabled = true;

            const service = serviceInput.value;
            const name = document.getElementById('name').value;
            const phone = document.getElementById('phone').value;
            const date = document.getElementById('date').value;
            const time = timeSelect.value;

            try {
                // Deterministic doc ID (phone+date+time) instead of addDoc's
                // random one: a genuine accidental double-submit (double
                // click, a slow network causing a retry, two tabs) then
                // just re-writes the SAME document instead of creating a
                // second appointment — enforced at the database level, not
                // just by the button-disable above.
                const bookingId = phone.replace(/\D/g, '') + '_' + date + '_' + time.replace(':', '');
                const bookingRef = doc(db, "appointments", bookingId);
                const existing = await getDoc(bookingRef);

                if (!existing.exists()) {
                    await setDoc(bookingRef, {
                        service_type: service,
                        patient_name: name,
                        patient_phone: phone,
                        appointment_date: date,
                        appointment_time: time, // Send purely as 24-hr layout securely matching admin dashboard
                        status: "Booked",
                        entry_source: "online",
                        createdAt: new Date(),
                        whatsapp_sent: false, // picked up by the WhatsApp notifier bot
                        // Placeholders prevent structural query errors on admin data loops
                        payment: "",
                        payment_type: "",
                        reference: "",
                        follow_up: ""
                    });
                }
                // If it already existed, this is a duplicate submission of the
                // exact same booking — nothing more to write, just re-derive
                // the same token/queue-position info the original submission
                // already got.

                // Join the shared, time-ordered token queue for this service+date.
                const dayEntries = await reassignDailyTokens(db, service, date);
                const mine = dayEntries.find(e => e.id === bookingId);
                const tokenNumber = mine ? mine.token_number : '';
                const aheadCount = mine ? countStillWaitingAhead(dayEntries, bookingId) : '';

                const params = new URLSearchParams({
                    name: name,
                    date: date,
                    time: formatTo12Hour(time), // Format for nice display on the confirmation page
                    service: service,
                    token: tokenNumber,
                    ahead: aheadCount
                });
                window.location.href = `confirmation.html?${params.toString()}`;
            } catch (error) {
                console.error("Error writing to cloud database: ", error);
                alert("Something went wrong. Please try again.");
                submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
