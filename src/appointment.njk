<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book an Appointment | Advanced Skin Clinic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet">

    <!-- Flatpickr CSS for the custom date picker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!-- Flatpickr Custom Theme -->
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/airbnb.css">

    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html, body {
            height: 100%;
            overflow-x: hidden;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
            color: #5f6b62;
            background-color: #f6f7f2;
            background-image: radial-gradient(120% 100% at 15% 0%, #eceee4 0%, #f6f7f2 55%);
            min-height: 100vh;
        }

        /* ---------- Page content ---------- */
        .form-content-area {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
        }
        .mockup-card {
            background-color: #fdfdfa;
            width: 100%;
            max-width: 650px;
            padding: 48px 55px;
            border-radius: 24px;
            border: 1px solid #dde1d6;
            box-shadow: 0 30px 60px -30px rgba(60,44,20,0.25);
        }
        .card-eyebrow {
            text-align: center;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #3f6d5c;
            margin-bottom: 10px;
        }
        h2 {
            font-family: 'Fraunces', Georgia, serif;
            font-weight: 400;
            font-size: 2.2rem;
            margin-bottom: 8px;
            text-align: center;
            color: #1e2420;
        }
        .card-subtitle {
            text-align: center;
            font-size: 0.95rem;
            color: #5f6b62;
            margin-bottom: 35px;
        }
        .form-row {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }
        .form-label {
            width: 140px;
            font-size: 16px;
            color: #1e2420;
            font-weight: 600;
            flex-shrink: 0;
        }
        .form-field-wrapper {
            flex-grow: 1;
            display: flex;
            gap: 15px;
            align-items: center;
            min-width: 0;
        }
        .input-box {
            width: 100%;
            background-color: #f6f7f2;
            border: 1px solid #dde1d6;
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 15px;
            font-family: inherit;
            outline: none;
            color: #1e2420;
        }
        .input-box:focus {
            border-color: #3f6d5c;
        }
        .input-box option:disabled {
            color: #b0b0b0;
            background-color: #f0f0f0;
        }
        .submit-btn-row {
            margin-top: 30px;
            display: flex;
            justify-content: center;
        }
        .btn-submit {
            padding: 14px 34px;
            font-size: 1rem;
            font-family: inherit;
            font-weight: 600;
            letter-spacing: 0.2px;
            cursor: pointer;
            border: none;
            border-radius: 999px;
            background-color: #3f6d5c;
            color: #fff;
            transition: background-color 0.3s;
        }
        .btn-submit:hover {
            background-color: #2d5145;
        }
        @media (max-width: 600px) {
            html, body {
                height: 100dvh;
                overflow: hidden;
                overscroll-behavior: none;
            }
            body {
                display: flex;
                flex-direction: column;
            }
            header {
                flex-shrink: 0;
            }
            .form-row {
                flex-direction: column;
                align-items: flex-start;
                gap: clamp(3px, 0.7vh, 6px);
                margin-bottom: 0;
            }
            .form-label {
                width: auto;
                font-size: clamp(13px, 2.1vh, 15px);
                font-weight: 600;
            }
            .form-field-wrapper {
                flex-direction: column;
                align-items: stretch;
                gap: clamp(6px, 1.1vh, 10px);
                width: 100%;
            }
            .form-field-wrapper > div {
                width: 100% !important;
            }
            .input-box {
                padding: clamp(9px, 1.6vh, 12px) 12px;
                font-size: clamp(13px, 2vh, 15px);
            }
            .submit-btn-row {
                justify-content: stretch;
                margin-top: clamp(2px, 0.5vh, 4px);
            }
            .btn-submit {
                width: 100%;
                padding: clamp(11px, 2vh, 15px) 20px;
                font-size: clamp(13px, 2vh, 15px);
            }
            .form-content-area {
                flex: 1 1 auto;
                min-height: 0;
                overflow: hidden;
                padding: 1.6vh 4vw;
                display: flex;
                align-items: stretch;
                justify-content: center;
            }
            .mockup-card {
                width: 100%;
                height: 100%;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 2.4vh 6vw;
                box-shadow: none;
            }
            .card-eyebrow {
                flex-shrink: 0;
                font-size: clamp(10px, 1.8vh, 12px);
                letter-spacing: 1.5px;
                margin-bottom: clamp(4px, 0.8vh, 8px);
            }
            h2 {
                flex-shrink: 0;
                font-size: clamp(19px, 3.6vh, 25px);
                line-height: 1.15;
                margin-bottom: clamp(3px, 0.6vh, 6px);
            }
            .card-subtitle {
                flex-shrink: 0;
                font-size: clamp(11px, 1.9vh, 13px);
                margin-bottom: clamp(10px, 2vh, 18px);
            }
            #appointmentForm {
                flex: 0 1 auto;
                min-height: 0;
                display: flex;
                flex-direction: column;
                gap: clamp(9px, 1.8vh, 16px);
            }
        }
    </style>
</head>
<body>

    {% include "partials/header.njk" %}

        <div class="form-content-area">
            <div class="mockup-card">
                <div class="card-eyebrow">Advanced Skin Clinic</div>
                <h2>Schedule Your Appointment</h2>
                <p class="card-subtitle">Start protecting your skin today.</p>
                <form id="appointmentForm">
                    <div class="form-row">
                        <label for="service" class="form-label">Service</label>
                        <div class="form-field-wrapper">
                            <select id="service" class="input-box" required>
                                <option value="" disabled selected>-- Choose a Service --</option>
                                <option value="Consultation">Consultation</option>
                                <option value="Laser Hair Removal">Laser Hair Removal</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <label for="name" class="form-label">Name</label>
                        <div class="form-field-wrapper">
                            <input type="text" id="name" class="input-box" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <label for="phone" class="form-label">Number</label>
                        <div class="form-field-wrapper">
                            <input type="tel" id="phone" class="input-box" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <label class="form-label">Schedule</label>
                        <div class="form-field-wrapper">
                            <!-- Wrapped in divs to ensure perfect 50/50 sizing immune to injected DOM elements -->
                            <div style="flex: 1; min-width: 0; width: 100%;">
                                <input type="text" id="date" name="date" class="input-box" placeholder="Select Date" required>
                            </div>
                            <div style="flex: 1; min-width: 0; width: 100%;">
                                <select id="time" class="input-box" required>
                                    <option value="" disabled selected>-- Select Time --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="submit-btn-row">
                        <button type="submit" class="btn-submit">Confirm Appointment</button>
                    </div>
                </form>
            </div>
        </div>

    <script>
        var mobileToggle = document.querySelector('.mobile-toggle');
        var navLinks = document.querySelector('nav.links');
        mobileToggle?.addEventListener('click', function(){
            var isOpen = navLinks.classList.toggle('mobile-open');
            mobileToggle.classList.toggle('open', isOpen);
            mobileToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        navLinks?.querySelectorAll('a').forEach(function(a){
            a.addEventListener('click', function(){
                navLinks.classList.remove('mobile-open');
                mobileToggle.classList.remove('open');
                mobileToggle.setAttribute('aria-expanded', 'false');
            });
        });
    </script>

    <!-- Flatpickr JS library -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script type="module">
        // This form is the single shared booking entry point for both
        // clinics — each backend owns its own appointment data, so a
        // booking here is routed to the right one at submit time rather
        // than written to a shared/legacy database.
        //
        // Consultation goes through ASC_consultation's public booking API
        // (server-side slot + token-queue validation, same as its own
        // /book/[clinicId] page), since that app's queue numbering has to
        // be recomputed atomically across every appointment that day —
        // logic that only exists server-side. Laser Hair Removal has no
        // such queue system in RadianceLaser, but it's the same shape of
        // fix: this used to write directly into RadianceLaser's Firestore
        // (a narrowly-scoped public rule allowed it), and now posts to
        // RadianceLaser's own public booking API instead — that Firestore
        // rule doesn't exist anymore, since RadianceLaser moved off
        // Firestore entirely (see RadianceLaser's prisma/schema.prisma).
        const CONSULTATION_API_BASE = "https://open.advancedskinclinic.in";
        const CONSULTATION_CLINIC_ID = "XF9qpYnL3K3fGHhC8bpl";

        const RADIANCE_API_BASE = "https://radiancelaser.in";
        // Was "ISXpiVfsWsryqAKIYz70" — that id doesn't correspond to any
        // real clinic (confirmed against both Firestore and Postgres: no
        // clinic doc, no appointments ever landed under it), so every LHR
        // booking through this form was silently failing before this fix,
        // unrelated to the Firestore-to-Postgres move on RadianceLaser's
        // side. This is RadianceLaser's actual clinic id.
        const RADIANCE_CLINIC_ID = "RL4ucpU7JPI8Lg22jqeE";

        const serviceInput = document.getElementById('service');
        const dateInput = document.getElementById('date');
        const timeSelect = document.getElementById('time');

        // --- TIME FORMATTING HELPER ---
        function formatTo12Hour(timeStr) {
            if (!timeStr) return '';
            const parts = timeStr.split(':');
            if (parts.length < 2) return timeStr;

            let hours = parseInt(parts[0], 10);
            const minutes = parts[1];

            if (isNaN(hours)) return timeStr;

            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;

            return `${hours}:${minutes} ${ampm}`;
        }

        // --- INITIALIZE FLATPICKR (GREYS OUT SUNDAYS) ---
        flatpickr("#date", {
            minDate: "today",
            dateFormat: "Y-m-d", // Keeps standard data format matching Firebase
            altInput: true,
            altFormat: "d/m/Y", // Visual presentation
            disable: [
                function(date) {
                    // Disable Sundays (0 = Sunday)
                    return (date.getDay() === 0);
                }
            ],
            onReady: function(selectedDates, dateStr, instance) {
                // Ensure default date is valid
                let defaultDate = new Date();
                if (defaultDate.getDay() === 0) {
                    defaultDate.setDate(defaultDate.getDate() + 1); // Shift to Monday
                }
                instance.setDate(defaultDate, true);
            },
            onChange: function(selectedDates, dateStr, instance) {
                updateAvailableTimeSlots();
            }
        });

        // --- GENERATE TIME SLOTS ---
        // Consultation's windows/interval mirror ASC_consultation's own
        // lib/slots.ts exactly (10-min slots, 10:00-14:00 / 16:00-20:00) so
        // a slot offered here is always one the booking API will actually
        // accept. Laser Hair Removal has no such source of truth in
        // RadianceLaser, so it keeps its own 60-minute clinic hours.
        function generateTimeSlots(service) {
            const isLaser = service === 'Laser Hair Removal';
            const interval = isLaser ? 60 : 10;
            const slots = [];

            function addSlotsInRange(startHour, startMin, endHour, endMin, inclusive) {
                const startTotalMins = startHour * 60 + startMin;
                const endTotalMins = endHour * 60 + endMin;

                for (let m = startTotalMins; inclusive ? m <= endTotalMins : m < endTotalMins; m += interval) {
                    const hh = String(Math.floor(m / 60)).padStart(2, '0');
                    const mins = String(m % 60).padStart(2, '0');
                    slots.push(`${hh}:${mins}`);
                }
            }

            if (isLaser) {
                addSlotsInRange(10, 0, 13, 30, true);
                slots.push("DIVIDER");
                addSlotsInRange(16, 30, 19, 30, true);
            } else {
                addSlotsInRange(10, 0, 14, 0, false);
                slots.push("DIVIDER");
                addSlotsInRange(16, 0, 20, 0, false);
            }

            return slots;
        }

        function fetchBookedTimes(service, date) {
            if (service === 'Laser Hair Removal') {
                const url = `${RADIANCE_API_BASE}/api/public/availability?clinicId=${encodeURIComponent(RADIANCE_CLINIC_ID)}&sessionType=lhr&date=${encodeURIComponent(date)}`;
                return fetch(url).then((res) => res.json()).then((data) => data.bookedTimes ?? []);
            }
            const url = `${CONSULTATION_API_BASE}/api/book/${encodeURIComponent(CONSULTATION_CLINIC_ID)}/availability?date=${encodeURIComponent(date)}`;
            return fetch(url).then((res) => res.json()).then((data) => data.bookedTimes ?? []);
        }

        let availabilityRequestId = 0;

        async function updateAvailableTimeSlots() {
            const selectedService = serviceInput.value;
            // Get raw YYYY-MM-DD from Flatpickr
            const selectedDate = document.getElementById('date').value;

            if (!selectedService || !selectedDate) return;

            const timeSlots = generateTimeSlots(selectedService);

            // Guards against a slower earlier request resolving after a
            // faster later one and clobbering the dropdown with stale data.
            const requestId = ++availabilityRequestId;
            let bookedTimesList = [];
            try {
                bookedTimesList = await fetchBookedTimes(selectedService, selectedDate);
            } catch (err) {
                console.error('Failed to load availability:', err);
            }
            if (requestId !== availabilityRequestId) return;

            const bookedTimes = new Set(bookedTimesList);
            const currentSelection = timeSelect.value;
            timeSelect.innerHTML = '<option value="" disabled selected>-- Select Time --</option>';

            timeSlots.forEach(slot => {
                // Check for our custom separator
                if (slot === "DIVIDER") {
                    const divider = document.createElement('option');
                    divider.disabled = true;
                    divider.textContent = '────── Evening ──────';
                    timeSelect.appendChild(divider);
                    return; // exit current loop cycle
                }

                const option = document.createElement('option');
                option.value = slot;
                option.textContent = formatTo12Hour(slot); // Render to user as 12hr

                if (bookedTimes.has(slot)) {
                    option.disabled = true;
                    option.textContent += ' (Booked)';
                }
                timeSelect.appendChild(option);
            });

            if (currentSelection && !bookedTimes.has(currentSelection)) {
                timeSelect.value = currentSelection;
            }
        }

        serviceInput.addEventListener('change', updateAvailableTimeSlots);

        // --- HANDLE FORM SUBMISSION ---
        document.getElementById('appointmentForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const service = serviceInput.value;
            const name = document.getElementById('name').value;
            const phone = document.getElementById('phone').value;
            const date = document.getElementById('date').value;
            const time = timeSelect.value;

            try {
                if (service === 'Laser Hair Removal') {
                    const res = await fetch(`${RADIANCE_API_BASE}/api/public/appointments`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            clinicId: RADIANCE_CLINIC_ID,
                            patientName: name,
                            patientPhone: phone,
                            date: date,
                            time: time,
                            durationMinutes: 60
                        })
                    });
                    const result = await res.json();
                    if (!res.ok || result.error) {
                        alert(result.error || "Something went wrong. Please try again.");
                        return;
                    }
                } else {
                    const res = await fetch(`${CONSULTATION_API_BASE}/api/book/${encodeURIComponent(CONSULTATION_CLINIC_ID)}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name, phone, date, time })
                    });
                    const result = await res.json();
                    if (!res.ok || result.error) {
                        alert(result.error || "Something went wrong. Please try again.");
                        return;
                    }
                }

                const params = new URLSearchParams({
                    name: name,
                    date: date,
                    time: formatTo12Hour(time), // Format for nice display on the confirmation page
                    service: service
                });
                window.location.href = `confirmation.html?${params.toString()}`;
            } catch (error) {
                console.error("Error submitting appointment: ", error);
                alert("Something went wrong. Please try again.");
            }
        });
    </script>
</body>
</html>
