<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appointment Confirmed | Advanced Skin Clinic</title>
    <link rel="icon" type="image/png" href="/assets/images/logo.png">
    <link rel="apple-touch-icon" href="/assets/images/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html, body {
            min-height: 100%;
            overflow-x: hidden;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
            color: #5f6b62;
            background-color: #f6f7f2;
            background-image: radial-gradient(120% 100% at 15% 0%, #eceee4 0%, #f6f7f2 55%);
            min-height: 100vh;
        }

        .confirm-content-area {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
        }
        .confirm-card {
            background-color: #fdfdfa;
            width: 100%;
            max-width: 560px;
            padding: 48px 48px 44px;
            border-radius: 24px;
            border: 1px solid #dde1d6;
            box-shadow: 0 30px 60px -30px rgba(60,44,20,0.25);
            text-align: center;
        }

        .check-wrap {
            width: 84px;
            height: 84px;
            margin: 0 auto 22px;
        }
        .check-circle {
            fill: none;
            stroke: #3f6d5c;
            stroke-width: 2.5;
            stroke-dasharray: 151;
            stroke-dashoffset: 151;
            animation: check-draw 0.6s ease-out forwards;
        }
        .check-mark {
            fill: none;
            stroke: #3f6d5c;
            stroke-width: 3;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 40;
            stroke-dashoffset: 40;
            animation: check-draw 0.4s 0.55s ease-out forwards;
        }
        @keyframes check-draw {
            to { stroke-dashoffset: 0; }
        }

        .confirm-eyebrow {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #3f6d5c;
            margin-bottom: 10px;
        }
        h1 {
            font-family: 'Fraunces', Georgia, serif;
            font-weight: 400;
            font-size: 2.2rem;
            line-height: 1.15;
            color: #1e2420;
            margin-bottom: 10px;
        }
        .confirm-subtitle {
            font-size: 0.95rem;
            color: #5f6b62;
            margin-bottom: 30px;
        }

        .details-box {
            background-color: #f6f7f2;
            border: 1px solid #dde1d6;
            border-radius: 16px;
            padding: 6px 24px;
            margin-bottom: 30px;
            text-align: left;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 20px;
            padding: 15px 0;
            border-bottom: 1px dashed #dde1d6;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #5f6b62;
            flex-shrink: 0;
        }
        .detail-value {
            font-size: 16px;
            font-weight: 600;
            color: #1e2420;
            text-align: right;
        }

        .btn-home {
            display: inline-block;
            padding: 14px 34px;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.2px;
            text-decoration: none;
            border-radius: 999px;
            background-color: #3f6d5c;
            color: #fff;
            transition: background-color 0.3s;
        }
        .btn-home:hover {
            background-color: #2d5145;
        }

        @media (max-width: 600px) {
            .confirm-content-area { padding: 28px 16px; }
            .confirm-card { padding: 34px 22px 30px; border-radius: 20px; }
            .check-wrap { width: 70px; height: 70px; margin-bottom: 16px; }
            h1 { font-size: 1.8rem; }
            .details-box { padding: 4px 18px; }
            .detail-row { padding: 13px 0; }
            .btn-home { display: block; }
        }
    </style>
</head>
<body>

    {% include "partials/header.njk" %}

    <div class="confirm-content-area">
        <div class="confirm-card">
            <div class="check-wrap">
                <svg viewBox="0 0 52 52" width="100%" height="100%">
                    <circle class="check-circle" cx="26" cy="26" r="24" />
                    <path class="check-mark" d="M14 27l7 7 17-17" />
                </svg>
            </div>

            <div class="confirm-eyebrow">Advanced Skin Clinic</div>
            <h1>Appointment Confirmed</h1>
            <p class="confirm-subtitle">We've received your request. We'll see you soon.</p>

            <div class="details-box" id="detailsBox">
                <div class="detail-row">
                    <span class="detail-label">Name</span>
                    <span class="detail-value" id="detailName">&mdash;</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Service</span>
                    <span class="detail-value" id="detailService">&mdash;</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Date</span>
                    <span class="detail-value" id="detailDate">&mdash;</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Time</span>
                    <span class="detail-value" id="detailTime">&mdash;</span>
                </div>
            </div>

            <a href="/" class="btn-home">Back to Home</a>
        </div>
    </div>

    <script>
        var mobileToggle = document.querySelector('.mobile-toggle');
        var navLinks = document.querySelector('nav.links');
        mobileToggle?.addEventListener('click', function(){
            var isOpen = navLinks.classList.toggle('mobile-open');
            mobileToggle.classList.toggle('open', isOpen);
            mobileToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        navLinks?.querySelectorAll('a').forEach(function(a){
            a.addEventListener('click', function(){
                navLinks.classList.remove('mobile-open');
                mobileToggle.classList.remove('open');
                mobileToggle.setAttribute('aria-expanded', 'false');
            });
        });

        // --- Populate booking details from URL query params ---
        const params = new URLSearchParams(window.location.search);
        const name = params.get('name');
        const service = params.get('service');
        const date = params.get('date');
        const time = params.get('time');

        if (name) document.getElementById('detailName').textContent = name;
        if (service) document.getElementById('detailService').textContent = service;

        if (date) {
            const parsedDate = new Date(`${date}T00:00:00`);
            document.getElementById('detailDate').textContent = isNaN(parsedDate)
                ? date
                : parsedDate.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        }

        // The booking page sends the time already formatted (e.g. "10:30 AM").
        if (time) document.getElementById('detailTime').textContent = time;

        if (!name && !service && !date && !time) {
            document.getElementById('detailsBox').style.display = 'none';
        }
    </script>
</body>
</html>
